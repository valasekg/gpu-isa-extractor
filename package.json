{
  "name": "nv-isa-extractor",
  "displayName": "NVIDIA ISA Extractor",
  "description": "Turn NVIDIA driver shader-cache blobs into readable SASS with decoded scheduling control codes, syntax highlighting and tooltips.",
  "version": "0.4.0",
  "publisher": "gvalasek",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "keywords": [
    "sass",
    "nvidia",
    "cuda",
    "nvdisasm",
    "gpu",
    "disassembly",
    "shader cache"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nvidia-sass"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nvIsaExtractor",
          "title": "NVIDIA ISA",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "nvIsaExtractor": [
        {
          "id": "nvIsaExtractor.objects",
          "name": "Shader Objects",
          "icon": "$(symbol-method)",
          "contextualTitle": "NVIDIA ISA",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nvIsaExtractor.objects",
        "when": "!nvIsaExtractor.hasBlob && !nvIsaExtractor.toolsReady",
        "contents": "nvdisasm was not found, so nothing can be disassembled yet. It ships with the CUDA Toolkit and cannot be bundled with this extension.\n[Check the Environment](command:nvIsaExtractor.doctor)\n[Open Settings](command:nvIsaExtractor.openSettings)"
      },
      {
        "view": "nvIsaExtractor.objects",
        "when": "!nvIsaExtractor.hasBlob && nvIsaExtractor.activeBlob",
        "enablement": "!nvIsaExtractor.busy",
        "contents": "The file open in the editor looks like a shader cache.\n[$(circuit-board) Scan the Active File](command:nvIsaExtractor.disassemble)"
      },
      {
        "view": "nvIsaExtractor.objects",
        "when": "default",
        "enablement": "!nvIsaExtractor.busy",
        "contents": "No shader-cache file is open.\n[Open a Shader Cache...](command:nvIsaExtractor.openBlobDialog)\nYou can also right-click a .bin, .toc or .nvph file in the Explorer, or use the button in the editor title bar when one is already open.\n[Check the Environment](command:nvIsaExtractor.doctor)"
      }
    ],
    "commands": [
      {
        "command": "nvIsaExtractor.disassemble",
        "title": "Open Shader-Cache File",
        "category": "NVIDIA ISA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "nvIsaExtractor.openBlobDialog",
        "title": "Open Shader-Cache File (Choose File)...",
        "category": "NVIDIA ISA",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nvIsaExtractor.refreshBlob",
        "title": "Rescan",
        "category": "NVIDIA ISA",
        "icon": "$(refresh)"
      },
      {
        "command": "nvIsaExtractor.closeBlob",
        "title": "Remove from the List",
        "category": "NVIDIA ISA",
        "icon": "$(close)"
      },
      {
        "command": "nvIsaExtractor.filter",
        "title": "Filter Shader Objects...",
        "category": "NVIDIA ISA",
        "icon": "$(filter)"
      },
      {
        "command": "nvIsaExtractor.openObject",
        "title": "Open Listing",
        "category": "NVIDIA ISA",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nvIsaExtractor.disassembleObject",
        "title": "Disassemble",
        "category": "NVIDIA ISA",
        "icon": "$(play)"
      },
      {
        "command": "nvIsaExtractor.toggleReviewed",
        "title": "Toggle Reviewed",
        "category": "NVIDIA ISA",
        "icon": "$(check)"
      },
      {
        "command": "nvIsaExtractor.clearReviewed",
        "title": "Clear Review Marks",
        "category": "NVIDIA ISA",
        "icon": "$(clear-all)"
      },
      {
        "command": "nvIsaExtractor.nextObject",
        "title": "Next Shader Object",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.previousObject",
        "title": "Previous Shader Object",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.nextUnreviewed",
        "title": "Next Unreviewed Shader Object",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.loadMore",
        "title": "Load More",
        "category": "NVIDIA ISA",
        "icon": "$(ellipsis)"
      },
      {
        "command": "nvIsaExtractor.openSettings",
        "title": "Open Settings",
        "category": "NVIDIA ISA",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nvIsaExtractor.doctor",
        "title": "Doctor (Check Environment)",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.clearOutput",
        "title": "Clear Generated Listings",
        "category": "NVIDIA ISA"
      }
    ],
    "keybindings": [
      {
        "command": "nvIsaExtractor.nextObject",
        "key": "ctrl+alt+pagedown",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.previousObject",
        "key": "ctrl+alt+pageup",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.nextUnreviewed",
        "key": "ctrl+alt+shift+pagedown",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.toggleReviewed",
        "key": "ctrl+alt+shift+m",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@50",
          "when": "resourceExtname =~ /^\\.(bin|toc|nvph)$/i"
        }
      ],
      "editor/title": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@50",
          "when": "resourceExtname =~ /^\\.(bin|toc|nvph)$/i"
        }
      ],
      "view/title": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@10",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.activeBlob"
        },
        {
          "command": "nvIsaExtractor.openBlobDialog",
          "group": "navigation@20",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.filter",
          "group": "navigation@30",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "group": "navigation@40",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "group": "1_review@10",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.doctor",
          "group": "2_tools@10",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.clearOutput",
          "group": "2_tools@20",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.openSettings",
          "group": "2_tools@30",
          "when": "view == nvIsaExtractor.objects"
        }
      ],
      "view/item/context": [
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "inline@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "group": "inline@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.openObject",
          "group": "1_open@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_open@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "group": "1_open@30",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_open@10",
          "when": "view == nvIsaExtractor.objects && viewItem == nvCopy"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "group": "inline@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.closeBlob",
          "group": "inline@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_batch@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "group": "2_review@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_batch@10",
          "when": "view == nvIsaExtractor.objects && viewItem == nvGroup"
        }
      ],
      "commandPalette": [
        {
          "command": "nvIsaExtractor.openObject",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.loadMore",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.closeBlob",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.nextObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.previousObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.nextUnreviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.filter",
          "when": "nvIsaExtractor.hasBlob"
        }
      ]
    },
    "languages": [
      {
        "id": "nvidia-sass",
        "aliases": [
          "NVIDIA SASS",
          "sass-nvidia",
          "nvsass"
        ],
        "extensions": [
          ".sass",
          ".nvsass"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^(?:\\s*\\.headerflags\\s+@\"EF_CUDA|\\s*(?:code|Function)\\s*(?:for|:)\\s|\\s*//-+\\s*\\.text\\.|\\s*/\\*[0-9a-fA-F]{4,}\\*/\\s+(?:@!?U?P[T0-9]\\s+)?[A-Z][A-Z0-9_]*)"
      }
    ],
    "grammars": [
      {
        "language": "nvidia-sass",
        "scopeName": "source.nvidia-sass",
        "path": "./syntaxes/sass.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "SASS Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sass-dark-color-theme.json"
      },
      {
        "label": "SASS Light",
        "uiTheme": "vs",
        "path": "./themes/sass-light-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "sassOpcode",
        "description": "SASS instruction mnemonic"
      },
      {
        "id": "sassModifier",
        "description": "Instruction postfix (.FTZ, .U32, ...)"
      },
      {
        "id": "sassVectorReg",
        "description": "Per-thread (vector) register R0-R254, RZ"
      },
      {
        "id": "sassUniformReg",
        "description": "Uniform (scalar) register UR0-UR63, URZ"
      },
      {
        "id": "sassPredicate",
        "description": "Predicate register P0-P7, PT"
      },
      {
        "id": "sassUniformPredicate",
        "description": "Uniform predicate UP0-UP7, UPT"
      },
      {
        "id": "sassSpecialReg",
        "description": "Special system register SR_*, SRZ"
      },
      {
        "id": "sassBarrier",
        "description": "Convergence / scoreboard barrier B0-B15, SB0-SB7"
      },
      {
        "id": "sassConstBank",
        "description": "Constant memory reference c[][] / cx[UR][]"
      },
      {
        "id": "sassAttribute",
        "description": "Attribute / interpolant space a[]"
      },
      {
        "id": "sassImmediate",
        "description": "Immediate literal"
      },
      {
        "id": "sassGuard",
        "description": "Guard predicate @P0 / @!P0"
      },
      {
        "id": "sassLabel",
        "description": "Branch target label"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "dst",
        "description": "Operand is written by this instruction"
      },
      {
        "id": "src",
        "description": "Operand is read by this instruction"
      },
      {
        "id": "discard",
        "description": "Destination is RZ/URZ - the result is discarded"
      },
      {
        "id": "tier1",
        "description": "First postfix after the opcode"
      },
      {
        "id": "tier2",
        "description": "Second postfix"
      },
      {
        "id": "tier3",
        "description": "Third and later postfixes"
      },
      {
        "id": "reuse",
        "description": "Operand served from the reuse cache"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "nvidia-sass",
        "scopes": {
          "sassOpcode": [
            "keyword.other.opcode.sass"
          ],
          "sassModifier": [
            "storage.modifier.postfix.sass"
          ],
          "sassModifier.tier1": [
            "storage.modifier.postfix.tier1.sass"
          ],
          "sassModifier.tier2": [
            "storage.modifier.postfix.tier2.sass"
          ],
          "sassModifier.tier3": [
            "storage.modifier.postfix.tier3.sass"
          ],
          "sassVectorReg": [
            "variable.other.register.vector.sass"
          ],
          "sassVectorReg.dst": [
            "variable.other.register.vector.sass"
          ],
          "sassVectorReg.src": [
            "variable.other.register.vector.sass"
          ],
          "sassVectorReg.discard": [
            "variable.other.register.vector.zero.sass"
          ],
          "sassUniformReg": [
            "variable.other.register.uniform.sass"
          ],
          "sassUniformReg.dst": [
            "variable.other.register.uniform.sass"
          ],
          "sassUniformReg.src": [
            "variable.other.register.uniform.sass"
          ],
          "sassUniformReg.discard": [
            "variable.other.register.uniform.zero.sass"
          ],
          "sassPredicate": [
            "variable.other.register.predicate.sass"
          ],
          "sassPredicate.dst": [
            "variable.other.register.predicate.sass"
          ],
          "sassPredicate.src": [
            "variable.other.register.predicate.sass"
          ],
          "sassPredicate.discard": [
            "variable.other.register.predicate.true.sass"
          ],
          "sassUniformPredicate": [
            "variable.other.register.uniform-predicate.sass"
          ],
          "sassUniformPredicate.dst": [
            "variable.other.register.uniform-predicate.sass"
          ],
          "sassUniformPredicate.src": [
            "variable.other.register.uniform-predicate.sass"
          ],
          "sassUniformPredicate.discard": [
            "variable.other.register.uniform-predicate.true.sass"
          ],
          "sassSpecialReg": [
            "variable.language.register.special.sass"
          ],
          "sassBarrier": [
            "variable.other.register.barrier.sass"
          ],
          "sassBarrier.dst": [
            "variable.other.register.barrier.sass"
          ],
          "sassBarrier.src": [
            "variable.other.register.barrier.sass"
          ],
          "sassConstBank": [
            "variable.other.constant-bank.sass"
          ],
          "sassAttribute": [
            "variable.other.attribute-space.sass"
          ],
          "sassImmediate": [
            "constant.numeric.sass"
          ],
          "sassGuard": [
            "keyword.control.guard.sass"
          ],
          "sassLabel": [
            "entity.name.label.sass"
          ]
        }
      }
    ],
    "configuration": {
      "title": "NVIDIA ISA Extractor",
      "properties": {
        "nvIsaExtractor.nvdisasmPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `nvdisasm`. Leave empty to look on `PATH` and then in `%CUDA_PATH%\\bin`. It ships with the CUDA Toolkit and cannot be bundled with this extension.",
          "scope": "machine",
          "order": 100
        },
        "nvIsaExtractor.arch": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Architecture to disassemble for, e.g. `SM86`. `auto` reads the compute capability of this machine's GPU, which is what compiled the cached shaders in the first place. Set it explicitly when there is no GPU, or more than one.",
          "scope": "machine",
          "order": 110
        },
        "nvIsaExtractor.minCodeBytes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Ignore shader objects with less microcode than this. Applied from the compressed frame header before anything is decompressed, so raising it makes a sweep markedly faster - `65536` is a good floor for DXCache, which holds thousands of small objects.",
          "scope": "window",
          "order": 120
        },
        "nvIsaExtractor.glcacheMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "toc",
            "scan"
          ],
          "enumItemLabels": [
            "Automatic",
            "Index only",
            "Scan only"
          ],
          "enumDescriptions": [
            "Use the .toc index, and fall back to scanning if it yields nothing.",
            "Use the .toc index only. Finds nothing if its layout has changed.",
            "Ignore the .toc entirely and find frames by their magic bytes. Slower, but immune to an index-layout change."
          ],
          "markdownDescription": "How to find shader objects in a GLCache `.bin`. The cache format is undocumented and does change across driver releases; `auto` notices an index that yields nothing and scans instead.",
          "scope": "window",
          "order": 130
        },
        "nvIsaExtractor.decodeControlCodes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Decode each instruction's scheduling control fields and print them as a `[B------:R-:W0:Y:S04]` column. Turn off to get nvdisasm's output verbatim.",
          "scope": "window",
          "order": 140
        },
        "nvIsaExtractor.keepRawMicrocode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the carved microcode next to the listing. It is always kept when nvdisasm fails, so that failure can be reproduced.",
          "scope": "window",
          "order": 150
        },
        "nvIsaExtractor.tree.sortBy": {
          "type": "string",
          "default": "size",
          "enum": [
            "size",
            "offset",
            "name"
          ],
          "enumItemLabels": [
            "Largest first",
            "File order",
            "Entry name"
          ],
          "enumDescriptions": [
            "Biggest shaders first - the ones most likely to be worth reading.",
            "The order they appear in the file, which is roughly the order they were compiled. Use this for a systematic front-to-back pass.",
            "Alphabetical by entry point. Most DXCache objects are unnamed and sort together at the end."
          ],
          "markdownDescription": "How shader objects are ordered in the Shader Objects view.",
          "scope": "window",
          "order": 190
        },
        "nvIsaExtractor.tree.autoGroupThreshold": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "Above this many shader objects, a file's contents are split into size buckets instead of one flat list. A DXCache bucket can hold ten thousand objects, which is not a list anyone can read.",
          "scope": "window",
          "order": 195
        },
        "nvIsaExtractor.tree.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "markdownDescription": "How many rows a level shows before a `Load moreâ€¦` entry. `0` shows everything at once.",
          "scope": "window",
          "order": 197
        },
        "nvIsaExtractor.batch.confirmAboveBytes": {
          "type": "number",
          "default": 268435456,
          "minimum": 0,
          "markdownDescription": "Ask before a batch disassembly whose listings would total more than this many bytes. Disassembling a whole cache file can produce gigabytes. `0` never asks.",
          "scope": "window",
          "order": 205
        },
        "nvIsaExtractor.tree.maxBlobs": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "markdownDescription": "How many cache files stay listed in the Shader Objects view at once. The least recently opened is dropped past this. Only the objects are kept, never the file's bytes, so this bounds a list rather than memory.",
          "scope": "window",
          "order": 200
        },
        "nvIsaExtractor.output.location": {
          "type": "string",
          "default": "globalStorage",
          "enum": [
            "globalStorage",
            "temp"
          ],
          "enumItemLabels": [
            "Extension storage",
            "System temp directory"
          ],
          "markdownDescription": "Where generated listings are written.",
          "scope": "window",
          "order": 160
        },
        "nvIsaExtractor.output.retentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Delete generated listings older than this many days, checked when the extension starts. `0` keeps them indefinitely. Listings open in an editor are never removed.",
          "scope": "window",
          "order": 170
        },
        "nvidiaSass.semanticMaxLines": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "Skip the semantic pass on documents longer than this. A large kernel disassembles to several hundred thousand lines, and the semantic provider re-reads the whole document each time it is asked. Syntax highlighting is unaffected - it only ever colours what is on screen.",
          "scope": "window",
          "order": 15
        },
        "nvidiaSass.scoreboard.highlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight scoreboard dependencies as you move the cursor. Putting the caret on a scoreboard inside a control column marks the instructions on the other end of that dependency - the arms a wait is waiting to drain, or the wait that drains an arm.",
          "scope": "window",
          "order": 16
        },
        "nvidiaSass.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Refine highlighting with a semantic pass that resolves operand roles (destination vs source) correctly, including stores and multi-destination instructions. Disable to fall back to the TextMate grammar alone.",
          "scope": "window",
          "order": 10
        },
        "nvidiaSass.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show tooltips for opcodes, postfixes, registers, constant banks and control codes.",
          "scope": "window",
          "order": 20
        },
        "nvidiaSass.hover.detail": {
          "type": "string",
          "default": "concise",
          "enum": [
            "concise",
            "elaborate"
          ],
          "enumItemLabels": [
            "Concise",
            "Elaborate"
          ],
          "enumDescriptions": [
            "Show the sourced opcode/postfix description and architecture availability.",
            "Also show an algorithmic model, operand behavior, execution domain, scheduling notes, current operand roles, and decoded active postfixes."
          ],
          "markdownDescription": "Select **Elaborate** to add algorithmic explanations, operand behavior, execution details, scheduling notes, live operand roles, and decoded postfixes to opcode tooltips.",
          "scope": "window",
          "order": 30
        },
        "nvidiaSass.hover.architecture": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
