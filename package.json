    "configuration": {
      "title": "NVIDIA ISA Extractor",
      "properties": {
        "nvIsaExtractor.nvdisasmPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `nvdisasm`. Leave empty to look on `PATH` and then in `%CUDA_PATH%\\bin`. It ships with the CUDA Toolkit and cannot be bundled with this extension.",
          "scope": "machine",
          "order": 100
        },
        "nvIsaExtractor.arch": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Architecture to disassemble for, e.g. `SM86`. `auto` reads the compute capability of this machine's GPU, which is what compiled the cached shaders in the first place. Set it explicitly when there is no GPU, or more than one.",
          "scope": "machine",
          "order": 110
        },
        "nvIsaExtractor.minCodeBytes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Ignore shader objects with less microcode than this. Applied from the compressed frame header before anything is decompressed, so raising it makes a sweep markedly faster - `65536` is a good floor for DXCache, which holds thousands of small objects.",
          "scope": "window",
          "order": 120
        },
        "nvIsaExtractor.glcacheMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "toc",
            "scan"
          ],
          "enumItemLabels": [
            "Automatic",
            "Index only",
            "Scan only"
          ],
          "enumDescriptions": [
            "Use the .toc index, and fall back to scanning if it yields nothing.",
            "Use the .toc index only. Finds nothing if its layout has changed.",
            "Ignore the .toc entirely and find frames by their magic bytes. Slower, but immune to an index-layout change."
          ],
          "markdownDescription": "How to find shader objects in a GLCache `.bin`. The cache format is undocumented and does change across driver releases; `auto` notices an index that yields nothing and scans instead.",
          "scope": "window",
          "order": 130
        },
        "nvIsaExtractor.decodeControlCodes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Decode each instruction's scheduling control fields and print them as a `[B------:R-:W0:Y:S04]` column. Turn off to get nvdisasm's output verbatim.",
          "scope": "window",
          "order": 140
        },
        "nvIsaExtractor.keepRawMicrocode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the carved microcode next to the listing. It is always kept when nvdisasm fails, so that failure can be reproduced.",
          "scope": "window",
          "order": 150
        },
        "nvIsaExtractor.tree.sortBy": {
          "type": "string",
          "default": "size",
          "enum": [
            "size",
            "offset",
            "name"
          ],
          "enumItemLabels": [
            "Largest first",
            "File order",
            "Entry name"
          ],
          "enumDescriptions": [
            "Biggest shaders first - the ones most likely to be worth reading.",
            "The order they appear in the file, which is roughly the order they were compiled. Use this for a systematic front-to-back pass.",
            "Alphabetical by entry point. Most DXCache objects are unnamed and sort together at the end."
          ],
          "markdownDescription": "How shader objects are ordered in the Shader Objects view.",
          "scope": "window",
          "order": 190
        },
        "nvIsaExtractor.tree.autoGroupThreshold": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "Above this many shader objects, a file's contents are split into size buckets instead of one flat list. A DXCache bucket can hold ten thousand objects, which is not a list anyone can read.",
          "scope": "window",
          "order": 195
        },
        "nvIsaExtractor.tree.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "markdownDescription": "How many rows a level shows before a `Load more…` entry. `0` shows everything at once.",
          "scope": "window",
          "order": 197
        },
        "nvIsaExtractor.batch.confirmAboveBytes": {
          "type": "number",
          "default": 268435456,
          "minimum": 0,
          "markdownDescription": "Ask before a batch disassembly whose listings would total more than this many bytes. Disassembling a whole cache file can produce gigabytes. `0` never asks.",
          "scope": "window",
          "order": 205
        },
        "nvIsaExtractor.tree.maxBlobs": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "markdownDescription": "How many cache files stay listed in the Shader Objects view at once. The least recently opened is dropped past this. Only the objects are kept, never the file's bytes, so this bounds a list rather than memory.",
          "scope": "window",
          "order": 200
        },
        "nvIsaExtractor.output.location": {
          "type": "string",
          "default": "globalStorage",
          "enum": [
            "globalStorage",
            "temp"
          ],
          "enumItemLabels": [
            "Extension storage",
            "System temp directory"
          ],
          "markdownDescription": "Where generated listings are written.",
          "scope": "window",
          "order": 160
        },
        "nvIsaExtractor.output.retentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Delete generated listings older than this many days, checked when the extension starts. `0` keeps them indefinitely. Listings open in an editor are never removed.",
          "scope": "window",
          "order": 170
        },
        "nvidiaSass.semanticMaxLines": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "Skip the semantic pass on documents longer than this. A large kernel disassembles to several hundred thousand lines, and the semantic provider re-reads the whole document each time it is asked. Syntax highlighting is unaffected - it only ever colours what is on screen.",
          "scope": "window",
          "order": 15
        },
        "nvidiaSass.scoreboard.highlight": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Highlight scoreboard dependencies as you move the cursor. Putting the caret on a scoreboard inside a control column marks the instructions on the other end of that dependency - the arms a wait is waiting to drain, or the wait that drains an arm.",
          "scope": "window",
          "order": 16
        },
        "nvidiaSass.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Refine highlighting with a semantic pass that resolves operand roles (destination vs source) correctly, including stores and multi-destination instructions. Disable to fall back to the TextMate grammar alone.",
          "scope": "window",
          "order": 10
        },
        "nvidiaSass.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show tooltips for opcodes, postfixes, registers, constant banks and control codes.",
          "scope": "window",
          "order": 20
        },
        "nvidiaSass.hover.detail": {
          "type": "string",
          "default": "concise",
          "enum": [
            "concise",
            "elaborate"
          ],
          "enumItemLabels": [
            "Concise",
            "Elaborate"
          ],
          "enumDescriptions": [
            "Show the sourced opcode/postfix description and architecture availability.",
            "Also show an algorithmic model, operand behavior, execution domain, scheduling notes, current operand roles, and decoded active postfixes."
          ],
          "markdownDescription": "Select **Elaborate** to add algorithmic explanations, operand behavior, execution details, scheduling notes, live operand roles, and decoded postfixes to opcode tooltips.",
          "scope": "window",
          "order": 30
        },
        "nvidiaSass.hover.architecture": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "turing",
            "ampere",
            "hopper",
            "blackwell",
            "any"
          ],
          "markdownDescription": "Which architecture's instruction set to check opcodes against. `auto` reads the SM version from the file's `.headerflags` and falls back to `any`.",
          "scope": "window",
          "order": 40
        },
        "nvIsaExtractor.compile.flags": {
          "type": "string",
          "default": "",
          "markdownDescription": "Flags applied to every compile, before the file's own `// nv-isa-extractor` line, which wins. Bare flags go to the compiler for the language being compiled - `slangc` for Slang (`-O3`, `-fp-mode fast`), NVRTC or `nvcc` for CUDA (`-use_fast_math`). Use `-Xptxas <flag>` for the PTX assembler and `-Xnvrtc <flag>` to reach the CUDA front end from a Slang file. `-I<dir>` adds an include directory for `#include` and `import`; the compiled file's own directory is always searched first, and a relative directory resolves against the file being compiled. `-Xvk <control>` describes the pipeline a vertex or fragment shader is compiled into - `bind=set:binding:type[:count]`, `push=bytes`, `producer=file[:entry]`, `format=`, `depth=`, `samples=` - which is only needed where reflection cannot know how your engine binds the shader."
        },
        "nvIsaExtractor.compile.backend": {
          "type": "string",
          "enum": [
            "auto",
            "nvrtc",
            "nvcc"
          ],
          "default": "auto",
          "markdownDescription": "Which CUDA front end compiles to PTX. `nvrtc` needs no host C++ compiler and is driven through a small Python helper; `nvcc` needs MSVC on Windows and fails with `Cannot find compiler 'cl.exe' in PATH` without it. `auto` prefers NVRTC."
        },
        "nvIsaExtractor.compile.correlate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Merge `//## <file>:<line>` markers into a compiled listing and light up the matching source line as the cursor moves. Attribution comes from the compiler's own line table; it is provenance, not a cost model."
        },
        "nvIsaExtractor.compile.slangcPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Explicit `slangc` path; empty auto-locates. Ships with the Vulkan SDK."
        },
        "nvIsaExtractor.compile.ptxasPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Explicit `ptxas` path; empty auto-locates via `PATH` and `%CUDA_PATH%\\bin`."
        },
        "nvIsaExtractor.compile.pythonPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Explicit Python interpreter for the NVRTC helper; empty tries `py`, then `python3`."
        },
        "nvIsaExtractor.compile.nvrtcPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Explicit `nvrtc64_*.dll`; empty searches `%CUDA_PATH%\\bind` and the loader path."
        },
        "nvIsaExtractor.compile.correlationStyle": {
          "type": "string",
          "enum": [
            "banner",
            "inline",
            "off"
          ],
          "default": "banner",
          "markdownDescription": "Where source correlation is recorded in a generated listing. `banner` keeps the instruction stream clean and puts an address map in the header. `inline` writes a `//## file:line` marker above each run, which survives being pasted as plain text but breaks the column alignment. `off` skips it."
        },
        "nvIsaExtractor.compile.clickToSass": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ctrl+click (Go to Definition) on a source line jumps to the first instruction it produced, when a listing for that file is open beside it."
        },
        "nvIsaExtractor.compile.traceCorrelation": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log why a source line highlighted nothing to the NVIDIA ISA Extractor output channel."
        },
        "nvIsaExtractor.compile.target": {
          "type": "string",
          "enum": [
            "auto",
            "nvidia",
            "amd"
          ],
          "default": "auto",
          "markdownDescription": "Which ISA to compile a shader for. `auto` decides per road rather than per machine: compute goes to NVIDIA whenever `ptxas` resolves, because it cross-compiles from a machine with no GPU; a graphics stage goes to NVIDIA only when the Vulkan probe finds an NVIDIA device, because that road is the local driver, and to AMD otherwise. The file's own `// gpu-isa-extractor -target` line wins over this."
        },
        "nvIsaExtractor.compile.rgaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit `rga` path; empty auto-locates. The Radeon GPU Analyzer is a free download and is not bundled - it is 227 MB, most of it back ends this road never uses."
        },
        "nvIsaExtractor.compile.gfx": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which AMD target to compile for, e.g. `gfx1201`. Empty asks `rga --list-asics` and takes the newest it offers. The supported list shrinks between RGA releases, so a pinned value can stop working on an upgrade and is checked against the live list."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvalasek/nv-isa-extractor"
  }
}
