{
  "name": "nv-isa-extractor",
  "displayName": "NVIDIA ISA Extractor",
  "description": "Turn NVIDIA driver shader-cache blobs into readable SASS with decoded scheduling control codes, syntax highlighting and tooltips.",
  "version": "0.1.0",
  "publisher": "gvalasek",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "keywords": [
    "sass",
    "nvidia",
    "cuda",
    "nvdisasm",
    "gpu",
    "disassembly",
    "shader cache"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nvidia-sass"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nvIsaExtractor.disassemble",
        "title": "Disassemble Shader-Cache Blob...",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.doctor",
        "title": "Doctor (Check Environment)",
        "category": "NVIDIA ISA"
      },
      {
        "command": "nvIsaExtractor.clearOutput",
        "title": "Clear Generated Listings",
        "category": "NVIDIA ISA"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@50",
          "when": "resourceExtname =~ /^\\.(bin|toc|nvph)$/i"
        }
      ]
    },
    "languages": [
      {
        "id": "nvidia-sass",
        "aliases": [
          "NVIDIA SASS",
          "sass-nvidia",
          "nvsass"
        ],
        "extensions": [
          ".sass",
          ".nvsass"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^(?:\\s*\\.headerflags\\s+@\"EF_CUDA|\\s*(?:code|Function)\\s*(?:for|:)\\s|\\s*//-+\\s*\\.text\\.|\\s*/\\*[0-9a-fA-F]{4,}\\*/\\s+(?:@!?U?P[T0-9]\\s+)?[A-Z][A-Z0-9_]*)"
      }
    ],
    "grammars": [
      {
        "language": "nvidia-sass",
        "scopeName": "source.nvidia-sass",
        "path": "./syntaxes/sass.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "SASS Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sass-dark-color-theme.json"
      },
      {
        "label": "SASS Light",
        "uiTheme": "vs",
        "path": "./themes/sass-light-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "sassOpcode", "description": "SASS instruction mnemonic" },
      { "id": "sassModifier", "description": "Instruction postfix (.FTZ, .U32, ...)" },
      { "id": "sassVectorReg", "description": "Per-thread (vector) register R0-R254, RZ" },
      { "id": "sassUniformReg", "description": "Uniform (scalar) register UR0-UR63, URZ" },
      { "id": "sassPredicate", "description": "Predicate register P0-P7, PT" },
      { "id": "sassUniformPredicate", "description": "Uniform predicate UP0-UP7, UPT" },
      { "id": "sassSpecialReg", "description": "Special system register SR_*, SRZ" },
      { "id": "sassBarrier", "description": "Convergence / scoreboard barrier B0-B15, SB0-SB7" },
      { "id": "sassConstBank", "description": "Constant memory reference c[][] / cx[UR][]" },
      { "id": "sassAttribute", "description": "Attribute / interpolant space a[]" },
      { "id": "sassImmediate", "description": "Immediate literal" },
      { "id": "sassGuard", "description": "Guard predicate @P0 / @!P0" },
      { "id": "sassLabel", "description": "Branch target label" }
    ],
    "semanticTokenModifiers": [
      { "id": "dst", "description": "Operand is written by this instruction" },
      { "id": "src", "description": "Operand is read by this instruction" },
      { "id": "discard", "description": "Destination is RZ/URZ - the result is discarded" },
      { "id": "tier1", "description": "First postfix after the opcode" },
      { "id": "tier2", "description": "Second postfix" },
      { "id": "tier3", "description": "Third and later postfixes" },
      { "id": "reuse", "description": "Operand served from the reuse cache" }
    ],
    "semanticTokenScopes": [
      {
        "language": "nvidia-sass",
        "scopes": {
          "sassOpcode": ["keyword.other.opcode.sass"],
          "sassModifier": ["storage.modifier.postfix.sass"],
          "sassModifier.tier1": ["storage.modifier.postfix.tier1.sass"],
          "sassModifier.tier2": ["storage.modifier.postfix.tier2.sass"],
          "sassModifier.tier3": ["storage.modifier.postfix.tier3.sass"],
          "sassVectorReg": ["variable.other.register.vector.sass"],
          "sassVectorReg.dst": ["variable.other.register.vector.sass"],
          "sassVectorReg.src": ["variable.other.register.vector.sass"],
          "sassVectorReg.discard": ["variable.other.register.vector.zero.sass"],
          "sassUniformReg": ["variable.other.register.uniform.sass"],
          "sassUniformReg.dst": ["variable.other.register.uniform.sass"],
          "sassUniformReg.src": ["variable.other.register.uniform.sass"],
          "sassUniformReg.discard": ["variable.other.register.uniform.zero.sass"],
          "sassPredicate": ["variable.other.register.predicate.sass"],
          "sassPredicate.dst": ["variable.other.register.predicate.sass"],
          "sassPredicate.src": ["variable.other.register.predicate.sass"],
          "sassPredicate.discard": ["variable.other.register.predicate.true.sass"],
          "sassUniformPredicate": ["variable.other.register.uniform-predicate.sass"],
          "sassUniformPredicate.dst": ["variable.other.register.uniform-predicate.sass"],
          "sassUniformPredicate.src": ["variable.other.register.uniform-predicate.sass"],
          "sassUniformPredicate.discard": ["variable.other.register.uniform-predicate.true.sass"],
          "sassSpecialReg": ["variable.language.register.special.sass"],
          "sassBarrier": ["variable.other.register.barrier.sass"],
          "sassBarrier.dst": ["variable.other.register.barrier.sass"],
          "sassBarrier.src": ["variable.other.register.barrier.sass"],
          "sassConstBank": ["variable.other.constant-bank.sass"],
          "sassAttribute": ["variable.other.attribute-space.sass"],
          "sassImmediate": ["constant.numeric.sass"],
          "sassGuard": ["keyword.control.guard.sass"],
          "sassLabel": ["entity.name.label.sass"]
        }
      }
    ],
    "configuration": {
      "title": "NVIDIA ISA Extractor",
      "properties": {
        "nvIsaExtractor.nvdisasmPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `nvdisasm`. Leave empty to look on `PATH` and then in `%CUDA_PATH%\\bin`. It ships with the CUDA Toolkit and cannot be bundled with this extension.",
          "scope": "machine",
          "order": 100
        },
        "nvIsaExtractor.arch": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Architecture to disassemble for, e.g. `SM86`. `auto` reads the compute capability of this machine's GPU, which is what compiled the cached shaders in the first place. Set it explicitly when there is no GPU, or more than one.",
          "scope": "machine",
          "order": 110
        },
        "nvIsaExtractor.minCodeBytes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Ignore shader objects with less microcode than this. Applied from the compressed frame header before anything is decompressed, so raising it makes a sweep markedly faster - `65536` is a good floor for DXCache, which holds thousands of small objects.",
          "scope": "window",
          "order": 120
        },
        "nvIsaExtractor.glcacheMode": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "toc", "scan"],
          "enumItemLabels": ["Automatic", "Index only", "Scan only"],
          "enumDescriptions": [
            "Use the .toc index, and fall back to scanning if it yields nothing.",
            "Use the .toc index only. Finds nothing if its layout has changed.",
            "Ignore the .toc entirely and find frames by their magic bytes. Slower, but immune to an index-layout change."
          ],
          "markdownDescription": "How to find shader objects in a GLCache `.bin`. The cache format is undocumented and does change across driver releases; `auto` notices an index that yields nothing and scans instead.",
          "scope": "window",
          "order": 130
        },
        "nvIsaExtractor.decodeControlCodes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Decode each instruction's scheduling control fields and print them as a `[B------:R-:W0:Y:S04]` column. Turn off to get nvdisasm's output verbatim.",
          "scope": "window",
          "order": 140
        },
        "nvIsaExtractor.keepRawMicrocode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the carved microcode next to the listing. It is always kept when nvdisasm fails, so that failure can be reproduced.",
          "scope": "window",
          "order": 150
        },
        "nvIsaExtractor.output.location": {
          "type": "string",
          "default": "globalStorage",
          "enum": ["globalStorage", "temp"],
          "enumItemLabels": ["Extension storage", "System temp directory"],
          "markdownDescription": "Where generated listings are written.",
          "scope": "window",
          "order": 160
        },
        "nvIsaExtractor.output.retentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Delete generated listings older than this many days, checked when the extension starts. `0` keeps them indefinitely. Listings open in an editor are never removed.",
          "scope": "window",
          "order": 170
        },
        "nvidiaSass.semanticMaxLines": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "Skip the semantic pass on documents longer than this. A large kernel disassembles to several hundred thousand lines, and the semantic provider re-reads the whole document each time it is asked. Syntax highlighting is unaffected - it only ever colours what is on screen.",
          "scope": "window",
          "order": 15
        },
        "nvidiaSass.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Refine highlighting with a semantic pass that resolves operand roles (destination vs source) correctly, including stores and multi-destination instructions. Disable to fall back to the TextMate grammar alone.",
          "scope": "window",
          "order": 10
        },
        "nvidiaSass.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show tooltips for opcodes, postfixes, registers, constant banks and control codes.",
          "scope": "window",
          "order": 20
        },
        "nvidiaSass.hover.detail": {
          "type": "string",
          "default": "concise",
          "enum": ["concise", "elaborate"],
          "enumItemLabels": ["Concise", "Elaborate"],
          "enumDescriptions": [
            "Show the sourced opcode/postfix description and architecture availability.",
            "Also show an algorithmic model, operand behavior, execution domain, scheduling notes, current operand roles, and decoded active postfixes."
          ],
          "markdownDescription": "Select **Elaborate** to add algorithmic explanations, operand behavior, execution details, scheduling notes, live operand roles, and decoded postfixes to opcode tooltips.",
          "scope": "window",
          "order": 30
        },
        "nvidiaSass.hover.architecture": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "turing", "ampere", "hopper", "blackwell", "any"],
          "markdownDescription": "Which architecture's instruction set to check opcodes against. `auto` reads the SM version from the file's `.headerflags` and falls back to `any`.",
          "scope": "window",
          "order": 40
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvalasek/nv-isa-extractor"
  }
}
