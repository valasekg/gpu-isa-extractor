{
  "name": "nv-isa-extractor",
  "displayName": "GPU ISA Extractor",
  "description": "Read the machine code your shaders really compile to - NVIDIA SASS and AMD RDNA ISA - inside VS Code.",
  "version": "0.12.1",
  "publisher": "gvalasek",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "keywords": [
    "sass",
    "nvidia",
    "cuda",
    "nvdisasm",
    "gpu",
    "disassembly",
    "shader cache",
    "amd",
    "rdna",
    "rga",
    "radeon"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nvidia-sass",
    "onLanguage:slang",
    "onLanguage:cuda-cpp",
    "onLanguage:cpp",
    "onLanguage:amd-rdna-isa"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nvIsaExtractor",
          "title": "NVIDIA ISA",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "nvIsaExtractor": [
        {
          "id": "nvIsaExtractor.objects",
          "name": "Shader Objects",
          "icon": "$(symbol-method)",
          "contextualTitle": "NVIDIA ISA",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nvIsaExtractor.objects",
        "when": "!nvIsaExtractor.hasBlob && nvIsaExtractor.toolsMissing",
        "contents": "nvdisasm was not found, so nothing can be disassembled yet. It ships with the CUDA Toolkit and cannot be bundled with this extension.\n[Check the Environment](command:nvIsaExtractor.doctor)\n[Open Settings](command:nvIsaExtractor.openSettings)"
      },
      {
        "view": "nvIsaExtractor.objects",
        "when": "!nvIsaExtractor.hasBlob && !nvIsaExtractor.toolsMissing && nvIsaExtractor.activeBlob",
        "enablement": "!nvIsaExtractor.busy",
        "contents": "The file open in the editor looks like a shader cache.\n[$(circuit-board) Scan the Active File](command:nvIsaExtractor.disassemble)"
      },
      {
        "view": "nvIsaExtractor.objects",
        "when": "!nvIsaExtractor.hasBlob && !nvIsaExtractor.toolsMissing && !nvIsaExtractor.activeBlob",
        "enablement": "!nvIsaExtractor.busy",
        "contents": "No shader-cache file is open.\n[Open a Shader Cache...](command:nvIsaExtractor.openBlobDialog)\nYou can also right-click a .bin, .toc or .nvph file in the Explorer, or use the button in the editor title bar when one is already open.\n[Check the Environment](command:nvIsaExtractor.doctor)"
      }
    ],
    "commands": [
      {
        "command": "nvIsaExtractor.disassemble",
        "title": "Open Shader-Cache File",
        "category": "GPU ISA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "nvIsaExtractor.openBlobDialog",
        "title": "Open Shader-Cache File (Choose File)...",
        "category": "GPU ISA",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nvIsaExtractor.refreshBlob",
        "title": "Rescan",
        "category": "GPU ISA",
        "icon": "$(refresh)"
      },
      {
        "command": "nvIsaExtractor.closeBlob",
        "title": "Remove from the List",
        "category": "GPU ISA",
        "icon": "$(close)"
      },
      {
        "command": "nvIsaExtractor.filter",
        "title": "Filter Shader Objects...",
        "category": "GPU ISA",
        "icon": "$(filter)"
      },
      {
        "command": "nvIsaExtractor.openObject",
        "title": "Open Listing",
        "category": "GPU ISA",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nvIsaExtractor.disassembleObject",
        "title": "Disassemble",
        "category": "GPU ISA",
        "icon": "$(play)"
      },
      {
        "command": "nvIsaExtractor.toggleReviewed",
        "title": "Toggle Reviewed",
        "category": "GPU ISA",
        "icon": "$(check)"
      },
      {
        "command": "nvIsaExtractor.clearReviewed",
        "title": "Clear Review Marks",
        "category": "GPU ISA",
        "icon": "$(clear-all)"
      },
      {
        "command": "nvIsaExtractor.nextObject",
        "title": "Next Shader Object",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.previousObject",
        "title": "Previous Shader Object",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.nextUnreviewed",
        "title": "Next Unreviewed Shader Object",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.loadMore",
        "title": "Load More",
        "category": "GPU ISA",
        "icon": "$(ellipsis)"
      },
      {
        "command": "nvIsaExtractor.openSettings",
        "title": "Open Settings",
        "category": "GPU ISA",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nvIsaExtractor.doctor",
        "title": "Doctor (Check Environment)",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.clearOutput",
        "title": "Clear Generated Listings",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.compileSource",
        "title": "Compile and Disassemble",
        "category": "GPU ISA",
        "icon": "$(gear)"
      },
      {
        "command": "nvIsaExtractor.compileSourceFor",
        "title": "Compile and Disassemble For...",
        "category": "GPU ISA"
      },
      {
        "command": "nvIsaExtractor.revealSource",
        "title": "Go to the Source Line for This Instruction",
        "category": "GPU ISA",
        "icon": "$(go-to-file)"
      }
    ],
    "keybindings": [
      {
        "command": "nvIsaExtractor.nextObject",
        "key": "ctrl+alt+pagedown",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.previousObject",
        "key": "ctrl+alt+pageup",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.nextUnreviewed",
        "key": "ctrl+alt+shift+n",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.toggleReviewed",
        "key": "ctrl+alt+shift+m",
        "when": "focusedView == nvIsaExtractor.objects || (editorTextFocus && editorLangId == nvidia-sass)"
      },
      {
        "command": "nvIsaExtractor.compileSource",
        "key": "ctrl+alt+shift+b",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(slang|cu|cuh|ptx|cubin)$/i"
      },
      {
        "command": "nvIsaExtractor.revealSource",
        "key": "ctrl+alt+shift+s",
        "when": "editorTextFocus && editorLangId == nvidia-sass"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@50",
          "when": "resourceExtname =~ /^\\.(bin|toc|nvph)$/i"
        },
        {
          "command": "nvIsaExtractor.compileSource",
          "group": "navigation@51",
          "when": "resourceExtname =~ /^\\.(slang|cu|cuh|ptx|cubin)$/i"
        }
      ],
      "editor/title": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@50",
          "when": "resourceExtname =~ /^\\.(bin|toc|nvph)$/i"
        },
        {
          "command": "nvIsaExtractor.compileSource",
          "group": "navigation@51",
          "when": "resourceExtname =~ /^\\.(slang|cu|cuh|ptx|cubin)$/i"
        }
      ],
      "view/title": [
        {
          "command": "nvIsaExtractor.disassemble",
          "group": "navigation@10",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.activeBlob"
        },
        {
          "command": "nvIsaExtractor.openBlobDialog",
          "group": "navigation@20",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.filter",
          "group": "navigation@30",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "group": "navigation@40",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "group": "1_review@10",
          "when": "view == nvIsaExtractor.objects && nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.doctor",
          "group": "2_tools@10",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.clearOutput",
          "group": "2_tools@20",
          "when": "view == nvIsaExtractor.objects"
        },
        {
          "command": "nvIsaExtractor.openSettings",
          "group": "2_tools@30",
          "when": "view == nvIsaExtractor.objects"
        }
      ],
      "view/item/context": [
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "inline@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "group": "inline@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.openObject",
          "group": "1_open@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_open@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "group": "1_open@30",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvObject/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_open@10",
          "when": "view == nvIsaExtractor.objects && viewItem == nvCopy"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "group": "inline@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.closeBlob",
          "group": "inline@20",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_batch@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "group": "2_review@10",
          "when": "view == nvIsaExtractor.objects && viewItem =~ /^nvFile/"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "group": "1_batch@10",
          "when": "view == nvIsaExtractor.objects && viewItem == nvGroup"
        }
      ],
      "commandPalette": [
        {
          "command": "nvIsaExtractor.openObject",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.loadMore",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.closeBlob",
          "when": "false"
        },
        {
          "command": "nvIsaExtractor.refreshBlob",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.disassembleObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.toggleReviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.clearReviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.nextObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.previousObject",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.nextUnreviewed",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.filter",
          "when": "nvIsaExtractor.hasBlob"
        },
        {
          "command": "nvIsaExtractor.compileSourceFor"
        }
      ],
      "editor/context": [
        {
          "command": "nvIsaExtractor.revealSource",
          "group": "navigation@10",
          "when": "editorLangId == nvidia-sass"
        }
      ]
    },
    "languages": [
      {
        "id": "nvidia-sass",
        "aliases": [
          "NVIDIA SASS",
          "sass-nvidia",
          "nvsass"
        ],
        "extensions": [
          ".sass",
          ".nvsass"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^(?:\\s*\\.headerflags\\s+@\"EF_CUDA|\\s*(?:code|Function)\\s*(?:for|:)\\s|\\s*//-+\\s*\\.text\\.|\\s*/\\*[0-9a-fA-F]{4,}\\*/\\s+(?:@!?U?P[T0-9]\\s+)?[A-Z][A-Z0-9_]*)"
      },
      {
        "id": "amd-rdna-isa",
        "aliases": [
          "AMD RDNA ISA",
          "rdna-isa",
          "rdnaisa"
        ],
        "extensions": [
          ".rdnaisa",
          ".isa"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^(?:_amdgpu_\\w+_main\\s*:|\\s+[a-z][a-z0-9_]*\\s.*//\\s*[0-9A-Fa-f]{8,16}\\s*:)"
      }
    ],
    "grammars": [
      {
        "language": "nvidia-sass",
        "scopeName": "source.nvidia-sass",
        "path": "./syntaxes/sass.tmLanguage.json"
      },
      {
        "language": "amd-rdna-isa",
        "scopeName": "source.amd-rdna-isa",
        "path": "./syntaxes/rdna.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "SASS Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sass-dark-color-theme.json"
      },
      {
        "label": "SASS Light",
        "uiTheme": "vs",
        "path": "./themes/sass-light-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "sassOpcode",
        "description": "SASS instruction mnemonic"
      },
      {
        "id": "sassModifier",
        "description": "Instruction postfix (.FTZ, .U32, ...)"
      },
      {
        "id": "sassVectorReg",
        "description": "Per-thread (vector) register R0-R254, RZ"
      },
      {
        "id": "sassUniformReg",
        "description": "Uniform (scalar) register UR0-UR63, URZ"
      },
      {
        "id": "sassPredicate",
        "description": "Predicate register P0-P7, PT"
      },
      {
        "id": "sassUniformPredicate",
        "description": "Uniform predicate UP0-UP7, UPT"
      },
      {
        "id": "sassSpecialReg",
        "description": "Special system register SR_*, SRZ"
      },
      {
        "id": "sassBarrier",
        "description": "Convergence / scoreboard barrier B0-B15, SB0-SB7"
      },
      {
        "id": "sassConstBank",
        "description": "Constant memory reference c[][] / cx[UR][]"
      },
      {
        "id": "sassAttribute",
        "description": "Attribute / interpolant space a[]"
      },
      {
        "id": "sassImmediate",
        "description": "Immediate literal"
      },
      {
        "id": "sassGuard",
        "description": "Guard predicate @P0 / @!P0"
      },
      {
        "id": "sassLabel",
        "description": "Branch target label"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "dst",
        "description": "Operand is written by this instruction"
      },
      {
        "id": "src",
        "description": "Operand is read by this instruction"
      },
      {
        "id": "discard",
        "description": "Destination is RZ/URZ - the result is discarded"
      },
      {
        "id": "tier1",
        "description": "First postfix after the opcode"
      },
      {
        "id": "tier2",
        "description": "Second postfix"
      },
      {
        "id": "tier3",
        "description": "Third and later postfixes"
      },
      {
        "id": "reuse",
        "description": "Operand served from the reuse cache"
      }
    ],
